<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
        Android 12+ splash screen using platform attributes directly.
        This keeps MEDIA•HUB independent from androidx.core:core-splashscreen
        while preserving the existing launcher artwork and post-splash theme.
    -->
    <style name="Theme.MyApplication.Launcher" parent="Theme.MyApplication">
        <item name="android:windowSplashScreenBackground">@color/splash_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/app_logo_mark</item>
        <item name="android:postSplashScreenTheme">@style/Theme.MyApplication</item>
    </style>
</resources>
