MEDIAHUB_ENV=development
MEDIAHUB_PUBLIC_BASE_URL=http://localhost:8080
MEDIAHUB_DATABASE_URL=postgresql://mediahub:change-me@db:5432/mediahub
MEDIAHUB_SESSION_SECRET=replace-with-a-long-random-secret
MEDIAHUB_PAIRING_TTL_SECONDS=300
MEDIAHUB_ALLOWED_ORIGINS=http://localhost:3000
# Never commit real credentials. Production values belong in the deployment secret store.
